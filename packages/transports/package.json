{
  "name": "@hopline/transports",
  "private": true,
  "version": "1.2.0",
  "description": "SSH, Telnet, raw TCP and serial transports for Hopline's session host (Node only, no Electron)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "smoke:legacy": "cd ../../apps/desktop && ELECTRON_RUN_AS_NODE=1 npx electron --experimental-transform-types ../../packages/transports/scripts/legacy-smoke.ts",
    "smoke:legacy:node": "node --experimental-transform-types scripts/legacy-smoke.ts"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@serialport/stream": "13.0.0",
    "serialport": "^13.0.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "@serialport/binding-mock": "^10.2.2",
    "@types/ssh2": "^1.15.6"
  }
}
