{
  "name": "@hopline/desktop",
  "private": true,
  "version": "1.2.0",
  "description": "Hopline: SSH/Telnet/Serial client for network engineers with a safety-first AI agent",
  "desktopName": "hopline.desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --config electron-builder.config.cjs --publish never --win nsis --x64",
    "dist:linux": "electron-vite build && electron-builder --config electron-builder.config.cjs --publish never --linux AppImage --x64",
    "dist:linux:all": "electron-vite build && electron-builder --config electron-builder.config.cjs --publish never --linux AppImage deb rpm --x64",
    "dist:mac": "electron-vite build && electron-builder --config electron-builder.config.cjs --publish never --mac",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@goodtools/wiregasm": "file:../../third_party/wiregasm/goodtools-wiregasm-2.0.0-hopline.1.tgz",
    "@hopline/cli-model": "*",
    "@hopline/guard": "*",
    "@hopline/importers": "*",
    "@hopline/parsers": "*",
    "@hopline/transports": "*",
    "@sentry/core": "^11.18.0",
    "@serialport/stream": "^13.0.0",
    "better-sqlite3": "^13.2.0",
    "electron-updater": "^6.8.11",
    "serialport": "^13.0.0",
    "ssh2": "1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@electron/fuses": "^2.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hopline/simulator": "*",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "electron": "45.5.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.79.0",
    "monaco-editor": "^0.58.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  },
  "license": "Apache-2.0",
  "author": "Hopline contributors",
  "homepage": "https://github.com/manuutr/hopline-terminal"
}
